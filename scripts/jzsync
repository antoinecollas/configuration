#!/usr/bin/env bash
set -euo pipefail

once=false
if [[ "${1:-}" == --once ]]; then
    once=true
    shift
fi
if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
    cat <<'HELP'
Usage: jzsync [--once] [LOCAL_DIR] [SUBPATH_UNDER_WORK]

Copy local code to Jean Zay, then watch for changes with fswatch.
--once copies and exits, suitable for running before job submission.
LOCAL_DIR defaults to the current directory; the remote subpath defaults to
its path relative to HOME. Git checkouts copy tracked files and local edits.
Git metadata, caches, data, environments, and .env files are excluded.
Remote files are not deleted. Results are not downloaded automatically.
Stop watching with Ctrl-C. JZ_FSWATCH_LATENCY defaults to 1 second.
HELP
    exit 0
fi
[[ $# -le 2 && "${1:-}" != -* ]] || { echo 'Usage: jzsync [--once] [LOCAL_DIR] [SUBPATH_UNDER_WORK]' >&2; exit 2; }
for tool in ssh rsync git; do
    command -v "$tool" >/dev/null || { echo "Missing required command: $tool" >&2; exit 1; }
done
if ! "$once"; then
    command -v fswatch >/dev/null || { echo 'Install fswatch: brew install fswatch' >&2; exit 1; }
fi

source_dir=$(cd "${1:-.}" && pwd -P)
subpath=${2-${source_dir#"$HOME"/}}
case "/$subpath/" in
    *'/../'*|*'/./'*|*'//'*) echo 'Provide a non-empty relative subpath without . or .. components.' >&2; exit 2 ;;
esac
[[ "$subpath" != /* && "$source_dir$subpath" != *$'\n'* ]] || { echo 'Provide a relative remote subpath; newline paths are unsupported.' >&2; exit 2; }

# Reuse authentication for rsync and later job commands.
if ssh -O check jz >/dev/null 2>&1; then
    echo '[jz] Reusing SSH master connection.'
else
    echo '[jz] Opening SSH master connection; authentication may be required.'
    ssh -MNf jz
fi
printf -v remote_command 'set -e; [[ "$WORK" == /* ]]; dest=$(realpath -m -- "$WORK"/%q); mkdir -p -- "$dest"; printf "__JZ__%%s\\n" "$dest"' "$subpath"
printf -v remote_command 'bash -lc %q' "$remote_command"
remote_dir=$(ssh jz "$remote_command" | sed -n 's/^__JZ__//p')
[[ "$remote_dir" == /* && "$remote_dir" != *$'\n'* ]] || { echo 'Could not resolve remote WORK.' >&2; exit 1; }

rsync_args=(-a --protect-args --itemize-changes)
for pattern in .git .cache data .venv __pycache__ .DS_Store .env '.env.*'; do
    # Explicit --files-from entries also need a rule matching directory contents.
    rsync_args+=(--exclude="$pattern" --exclude="**/$pattern/***")
done
sync_tmp=$(mktemp -d)
file_list=''
watcher_pid=''
cleanup() {
    if [[ -n "$watcher_pid" ]]; then
        kill "$watcher_pid" 2>/dev/null || true
        wait "$watcher_pid" 2>/dev/null || true
    fi
    rm -f "$sync_tmp/files" "$sync_tmp/events"
    rmdir "$sync_tmp"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ $(git -C "$source_dir" rev-parse --is-inside-work-tree 2>/dev/null || true) == true ]]; then
    file_list="$sync_tmp/files"
    rsync_args+=(--from0 --files-from="$file_list")
    echo '[jz] Copying tracked files, including local edits. Stage new files with git add.'
else
    echo '[jz] Copying all files except the configured exclusions.'
fi

sync_once() {
    if [[ -n "$file_list" ]]; then
        # Refresh for newly staged files; skip local deletions and submodule directories.
        (cd "$source_dir"
         git ls-files -z | while IFS= read -r -d '' file; do
             if [[ -f "$file" || -L "$file" ]]; then printf '%s\0' "$file"; fi
         done) > "$file_list"
    fi
    rsync "${rsync_args[@]}" "$source_dir/" "jz:$remote_dir/"
    echo '[jz] Sync complete.'
}

printf '[jz] %s -> %s\n' "$source_dir" "$remote_dir"
sync_once
"$once" && exit 0

echo '[jz] Watching local changes; Ctrl-C to stop.'
mkfifo "$sync_tmp/events"
fswatch -r -o -l "${JZ_FSWATCH_LATENCY:-1.0}" "$source_dir" > "$sync_tmp/events" &
watcher_pid=$!
while IFS= read -r _; do sync_once; done < "$sync_tmp/events"
wait "$watcher_pid"
watcher_pid=''
